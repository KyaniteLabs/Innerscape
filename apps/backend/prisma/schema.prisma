generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  preferences   UserPreference?
  checkIns      EmotionalCheckIn[]
  journalEntries JournalEntry[]
  insights      Insight[]
  habits        Habit[]
  goals         Goal[]
  tasks         Task[]
  dopamineMenu  DopamineMenuItem[]
  bodyCheckIns  BodyCheckIn[]
  sleepLogs     SleepLog[]
  somaticMaps   SomaticMapping[]
  spaces        Space[]
  spaceScans    SpaceScan[]
  captureItems  CaptureItem[]
  projects      Project[]
  knowledgeItems KnowledgeItem[]
  declutterSessions DeclutterSession[]
  publicListings PublicListing[]
  tradeListings TradeListing[]

  @@map("users")
}

model UserPreference {
  id                String @id @default(uuid())
  userId            String @unique
  timezone          String @default("UTC")
  shutdownRitualTime String @default("21:00")
  weeklyReviewDay   Int    @default(0)
  fontSize          String @default("medium")
  highContrast      Boolean @default(false)
  reducedMotion     Boolean @default(false)
  dyslexiaFont      Boolean @default(false)
  checkInReminders  Boolean @default(true)
  shutdownRitual    Boolean @default(true)
  weeklyReview      Boolean @default(true)
  insightAlerts     Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model EmotionalCheckIn {
  id                String   @id @default(uuid())
  userId            String
  energyLevel       Int
  valence           String
  feelingLabel      String?
  bodySensationNote String?
  source            String   @default("manual")
  timestamp         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, timestamp])
  @@map("emotional_checkins")
}

model JournalEntry {
  id            String   @id @default(uuid())
  userId        String
  content       String
  tags          String[]
  linkedCheckIns String[]
  aiPromptUsed  String?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("journal_entries")
}

model Insight {
  id          String    @id @default(uuid())
  userId      String
  type        String
  title       String
  description String
  confidence  Float
  dataPoints  String[]
  dismissedAt DateTime?
  actedUponAt DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("insights")
}

model Habit {
  id             String    @id @default(uuid())
  userId         String
  name           String
  frequency      String    @default("daily")
  streak         Int       @default(0)
  longestStreak  Int       @default(0)
  lastCompletedAt DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("habits")
}

model Goal {
  id           String   @id @default(uuid())
  userId       String
  title        String
  description  String?
  deadline     DateTime?
  status       String   @default("active")
  parentGoalId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("goals")
}

model Task {
  id                   String    @id @default(uuid())
  goalId               String?
  userId               String
  title                String
  estimatedDuration    Int
  completed            Boolean   @default(false)
  completedAt          DateTime?
  dueDate              DateTime?
  contextRequirements  String[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, completed])
  @@map("tasks")
}

model DopamineMenuItem {
  id                 String    @id @default(uuid())
  userId             String
  category           String
  name               String
  instructions       String[]
  estimatedDuration  Int
  effectivenessScore Float?
  lastUsedAt         DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, category])
  @@map("dopamine_menu_items")
}

model BodyCheckIn {
  id                 String   @id @default(uuid())
  userId             String
  bodyScan           Json
  emotionWheelFeeling String
  emotionWheelValence String
  aiHypothesis       String?
  reflectionRating   Int?
  timestamp          DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, timestamp])
  @@map("body_checkins")
}

model SomaticMapping {
  id               String    @id @default(uuid())
  userId           String
  sensationPattern Json
  predictedEmotion String
  confidence       Float
  occurrences      Int       @default(1)
  lastValidatedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("somatic_mappings")
}

model SleepLog {
  id            String   @id @default(uuid())
  userId        String
  date          DateTime
  durationHours Float
  qualityScore  Int
  source        String   @default("manual")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("sleep_logs")
}

model Space {
  id        String   @id @default(uuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  scans SpaceScan[]

  @@index([userId])
  @@map("spaces")
}

model SpaceScan {
  id              String    @id @default(uuid())
  spaceId         String
  userId          String
  beforePhotoUri  String
  afterPhotoUri   String?
  scannedAt       DateTime  @default(now())
  completedAt     DateTime?
  durationSeconds Int?
  status          String    @default("active")

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  space Space         @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  items DetectedItem[]

  @@index([spaceId, scannedAt])
  @@map("space_scans")
}

model DetectedItem {
  id                  String   @id @default(uuid())
  scanId              String
  label               String
  confidence          Float
  decision            String   @default("undecided")
  decidedAt           DateTime?
  estimatedValueCents Int?
  category            String?
  condition           String   @default("unknown")
  valuationJson       Json?
  listingDraftJson    Json?

  scan SpaceScan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId])
  @@map("detected_items")
}

model CaptureItem {
  id                  String   @id @default(uuid())
  userId              String
  content             String
  contentType         String
  capturedAt          DateTime @default(now())
  source              String   @default("app")
  classificationStatus String  @default("pending")
  classifiedModule    String?
  classifiedType      String?
  classifiedConfidence Float?
  tags                String[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, classificationStatus])
  @@map("capture_items")
}

model Project {
  id       String   @id @default(uuid())
  userId   String
  name     String
  area     String?
  deadline DateTime
  status   String   @default("active")
  taskIds  String[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("projects")
}

model KnowledgeItem {
  id               String   @id @default(uuid())
  userId           String
  title            String
  content          String
  paraCategory     String
  tags             String[]
  lastAccessedAt   DateTime @default(now())
  relatedProjectIds String[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, paraCategory])
  @@map("knowledge_items")
}

// ── Declutter Bounded Context ────────────────────────────────────────────────

model DeclutterSession {
  id             String    @id @default(uuid())
  userId         String
  imageStorageKey String?
  createdAt      DateTime  @default(now())

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      DeclutterItem[]
  publicListings PublicListing[]

  @@index([userId, createdAt])
  @@map("declutter_sessions")
}

model DeclutterItem {
  id              String   @id @default(uuid())
  sessionId       String
  label           String
  condition       String   @default("unknown")
  valuationJson   Json
  listingDraftJson Json
  createdAt       DateTime @default(now())

  session     DeclutterSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  decision    DeclutterDecision?

  @@index([sessionId])
  @@map("declutter_items")
}

model DeclutterDecision {
  id         String   @id @default(uuid())
  itemId     String   @unique
  sessionId  String
  decision   String
  note       String?
  decidedAt  DateTime @default(now())

  item DeclutterItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("declutter_decisions")
}

model PublicListing {
  id            String   @id @default(uuid())
  userId        String
  sessionId     String
  itemId        String
  title         String
  description   String
  condition     String
  priceUsd      Float
  categoryHint  String
  createdAt     DateTime @default(now())

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  session DeclutterSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId, sessionId])
  @@index([createdAt])
  @@map("public_listings")
}

// ── Price Estimation ─────────────────────────────────────────────────────────

model PriceRange {
  id               Int      @id @default(autoincrement())
  label            String
  normalizedLabel  String   @unique
  category         String?
  lowPrice         Float
  medianPrice      Float
  highPrice        Float
  compCount        Int      @default(0)
  source           String
  confidence       String
  updatedAt        DateTime @default(now())

  @@index([normalizedLabel])
  @@map("price_ranges")
}

model PriceFeedback {
  id                Int      @id @default(autoincrement())
  label             String
  normalizedLabel   String
  expectedMedianUsd Float
  reason            String?
  source            String   @default("user")
  createdAt         DateTime @default(now())

  @@index([normalizedLabel])
  @@map("price_feedback")
}

model CommunitySale {
  id              Int      @id @default(autoincrement())
  label           String
  normalizedLabel String
  salePriceUsd    Float
  condition       String?
  platform        String?
  notes           String?
  soldAt          DateTime @default(now())

  @@index([normalizedLabel])
  @@map("community_sales")
}

model PriceHistory {
  id              Int      @id @default(autoincrement())
  label           String
  normalizedLabel String
  lowPrice        Float
  medianPrice     Float
  highPrice       Float
  source          String
  changedAt       DateTime @default(now())

  @@index([normalizedLabel])
  @@map("price_history")
}

// ── Trade Marketplace ────────────────────────────────────────────────────────

model TradeListing {
  id                  String   @id @default(uuid())
  userId              String
  itemLabel           String
  description         String?
  condition           String?
  valuationMedianUsd  Float?
  tradeValueCredits   Float?
  latitude            Float?
  longitude           Float?
  images              String[]
  tags                String[]
  wantsInReturn       String[]
  status              String   @default("available")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  matches TradeMatch[]

  @@index([status])
  @@map("trade_listings")
}

model TradeMatch {
  id               String   @id @default(uuid())
  listingId        String
  requesterId      String
  ownerId          String
  offeredListingId String?
  message          String?
  useCredits       Boolean  @default(false)
  creditAmount     Float    @default(0)
  status           String   @default("pending")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  listing TradeListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reviews TradeReview[]

  @@index([listingId])
  @@map("trade_matches")
}

model TradeReview {
  id            String   @id @default(uuid())
  tradeMatchId  String
  ratedUserId   String
  raterUserId   String
  rating        Int
  tags          String[]
  comment       String?
  createdAt     DateTime @default(now())

  match TradeMatch @relation(fields: [tradeMatchId], references: [id], onDelete: Cascade)

  @@index([ratedUserId])
  @@index([tradeMatchId])
  @@map("trade_reviews")
}

model CreditTransaction {
  id         Int      @id @default(autoincrement())
  userId     String
  amount     Float
  tradeId    String?
  itemLabel  String
  direction  String
  createdAt  DateTime @default(now())

  @@index([userId])
  @@map("credit_transactions")
}
