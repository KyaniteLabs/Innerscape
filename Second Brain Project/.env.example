# LifeOS Web App Environment Variables
# Copy this file to .env.local and fill in the values

# Server-side API URL (for server components and actions)
LIFEOS_API_URL=https://api.innerscape.app/api

# Client-side API URL (for client components)
NEXT_PUBLIC_API_URL=https://api.innerscape.app/api

# Clerk Authentication
CLERK_SECRET_KEY=your_clerk_secret_key_here
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here

# Database (Turso)
DATABASE_URL=libsql://your-db.turso.io
DATABASE_AUTH_TOKEN=your_auth_token_here

# AI (GLM-4)
GLM_API_KEY=your_glm_api_key_here
