# LifeOS Backend - Local Development Configuration
# This file is used by Wrangler for local development secrets

# Enable local development mode (bypasses Clerk authentication)
LOCAL_DEV=true

# Local SQLite database - use absolute path for Wrangler
TURSO_CONNECTION_URL=file:/Volumes/External Drive/02_DEVELOPMENT/Active Projects/LifeOS/lifeos-backend/local.db
TURSO_AUTH_TOKEN=

# Clerk is not needed when LOCAL_DEV=true
CLERK_SECRET_KEY=not-needed-for-local
