# Clerk Authentication
# Must match the publishable key in Clerk Dashboard
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# PowerSync Configuration
# Get this from PowerSync Dashboard
EXPO_PUBLIC_POWERSYNC_URL=https://[your-id].powersync.app

# API Endpoint (Optional if using local-only for smoke test)
EXPO_PUBLIC_API_URL=http://localhost:8787/api
