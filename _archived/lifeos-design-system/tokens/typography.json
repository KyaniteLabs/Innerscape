{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lifeos-design-tokens-typography",
  "font": {
    "family": {
      "display": { "value": "Outfit", "comment": "For large headings and display text" },
      "heading": { "value": "Outfit", "comment": "For section headings" },
      "body": { "value": "Satoshi", "comment": "For body text and UI - 2026 Modern standard" },
      "mono": { "value": "JetBrains Mono", "comment": "For code and data" }
    },
    "weight": {
      "regular": { "value": "400" },
      "medium": { "value": "500" },
      "semibold": { "value": "600" },
      "bold": { "value": "700" }
    },
    "size": {
      "xs": { "value": "12px" },
      "sm": { "value": "14px" },
      "base": { "value": "16px" },
      "lg": { "value": "18px" },
      "xl": { "value": "20px" },
      "2xl": { "value": "24px" },
      "3xl": { "value": "30px" },
      "4xl": { "value": "36px" },
      "5xl": { "value": "48px" }
    },
    "lineHeight": {
      "tight": { "value": "1.25" },
      "normal": { "value": "1.5" },
      "relaxed": { "value": "1.75" }
    }
  },
  "textStyle": {
    "display": {
      "fontFamily": { "value": "{font.family.display}" },
      "fontWeight": { "value": "{font.weight.bold}" },
      "fontSize": { "value": "{font.size.5xl}" },
      "lineHeight": { "value": "{font.lineHeight.tight}" }
    },
    "h1": {
      "fontFamily": { "value": "{font.family.heading}" },
      "fontWeight": { "value": "{font.weight.semibold}" },
      "fontSize": { "value": "{font.size.3xl}" },
      "lineHeight": { "value": "{font.lineHeight.tight}" }
    },
    "h2": {
      "fontFamily": { "value": "{font.family.heading}" },
      "fontWeight": { "value": "{font.weight.semibold}" },
      "fontSize": { "value": "{font.size.2xl}" },
      "lineHeight": { "value": "{font.lineHeight.tight}" }
    },
    "h3": {
      "fontFamily": { "value": "{font.family.heading}" },
      "fontWeight": { "value": "{font.weight.semibold}" },
      "fontSize": { "value": "{font.size.xl}" },
      "lineHeight": { "value": "{font.lineHeight.tight}" }
    },
    "body": {
      "fontFamily": { "value": "{font.family.body}" },
      "fontWeight": { "value": "{font.weight.regular}" },
      "fontSize": { "value": "{font.size.base}" },
      "lineHeight": { "value": "{font.lineHeight.normal}" }
    },
    "bodyBold": {
      "fontFamily": { "value": "{font.family.body}" },
      "fontWeight": { "value": "{font.weight.semibold}" },
      "fontSize": { "value": "{font.size.base}" },
      "lineHeight": { "value": "{font.lineHeight.normal}" }
    },
    "caption": {
      "fontFamily": { "value": "{font.family.body}" },
      "fontWeight": { "value": "{font.weight.regular}" },
      "fontSize": { "value": "{font.size.xs}" },
      "lineHeight": { "value": "{font.lineHeight.normal}" }
    },
    "mono": {
      "fontFamily": { "value": "{font.family.mono}" },
      "fontWeight": { "value": "{font.weight.regular}" },
      "fontSize": { "value": "{font.size.sm}" },
      "lineHeight": { "value": "{font.lineHeight.normal}" }
    }
  }
}
